# Demo frontend — copy to .env.local for local development
# All traffic is served by the built-in mock API (src/app/api/[...path]/route.ts),
# so no Laravel backend or database is required.

# Base URL of the API. Keep relative (/api) so the same config works
# locally and on any deployment domain (e.g. Vercel).
NEXT_PUBLIC_API_URL=/api

# Real Midtrans popup is disabled in the demo; a simulated payment
# endpoint (POST /api/payments/simulate) is used instead.
NEXT_PUBLIC_MIDTRANS_ENABLED=false

# Enables demo-only UI affordances (e.g. simulated payment button).
NEXT_PUBLIC_DEMO_MODE=true
